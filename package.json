{
  "name": "plastic-bottle-business",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "BottleDesk - inventory, buying, selling and profit tracking for a plastic bottle business (web app, server and Android app)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "app": "vite build && node server/index.js",
    "test": "node --test",
    "apk": "node scripts/build-apk.mjs",
    "android:add": "cap add android",
    "android:assets": "npx --yes @capacitor/assets generate --android",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^6.1.2",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^6.2.7"
  }
}
